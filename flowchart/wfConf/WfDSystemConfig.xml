			<selectOption value=""> </selectOption>
			<selectOption value="toupiao">Voting Mode</selectOption>
		</select>
		<select id="taskAssign" title="Task Delegation Rule:" size="200">
			<selectOption value="taskAutoMode" selected="true">Automatic</selectOption>
			<selectOption value="taskOrgConvertMode" >Department Default</selectOption>
			<selectOption value="taskRandomMode">Random</selectOption>
		</select>	
		<select id="MustActivity" title="Must-end Step:" size="200">
