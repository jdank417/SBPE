	<Applications>
		<Application Id="workflow_DefaultToolAgent" Name="Run other toolagent">
			<Description>Run other toolagent</Description>
			<FormalParameters>
				<FormalParameter Id="ToolAgentClass" Index="0" Mode="IN" Description="Other component name">
					<DataType>
						<ExternalReference location="java.lang.String"/>
					</DataType>
				</FormalParameter>                
			</FormalParameters>                
			<ExtendedAttributes>
				<ExtendedAttribute Name="ToolAgentClass" Value="" Description="Name of another toolagent to use"/>
			</ExtendedAttributes>
		</Application>
		<Application Id="workflow_sendMailToolAgent" Name="Send Email">
			<Description>Send email</Description>
			<FormalParameters>
				<FormalParameter Id="body" Index="body" Mode="IN" Description="Email body">
					<DataType>
						<BasicType Type="STRING"/>
					</DataType>
				</FormalParameter>
				<FormalParameter Id="subject" Index="subject" Mode="IN" Description="Email subject">
					<DataType>
						<BasicType Type="STRING"/>
					</DataType>
				</FormalParameter>
				<FormalParameter Id="to" Index="to" Mode="IN" Description="Email addresses, separate multiple with ,">
					<DataType>
						<BasicType Type="STRING"/>
					</DataType>
				</FormalParameter>
			</FormalParameters>
		</Application>
       	<!--  
        <Application Id="workflow_javaClassToolAgent" Name="Run Java static method">
            <Description>Method name is execute</Description>
            <ExtendedAttributes>
                <ExtendedAttribute Name="ToolAgentClass" Description="Java class name to execute"/>
            </ExtendedAttributes>
		</Application> -->
		<Application Id="workflow_dbToolAgent" Name="Modify data">
			<Description>Modify database data</Description>
			<FormalParameters>
				<FormalParameter Id="tableName" Index="0" Mode="IN" Description="Table name">
					<DataType>
						<ExternalReference location="java.lang.String"/>
					</DataType>
				</FormalParameter>                
				<FormalParameter Id="dbdata" Index="1" Mode="IN" Description="Data to operate on; can be a String, pojo, or Map">
					<DataType>
						<ExternalReference location="java.lang.Object"/>
					</DataType>
				</FormalParameter>
				<FormalParameter Id="DbActionType" Index="2" Mode="IN" Description="database operation type, values: 1 insert 2 update 3 delete">
					<DataType>
						<BasicType Type="INTEGER"/>
					</DataType>
				</FormalParameter>
				<FormalParameter Id="Condition" Index="3" Mode="IN" Description="Data operation condition; can be a pojo or Map, used as the operation condition">
					<DataType>
						<ExternalReference location="java.lang.Object"/>
					</DataType>
				</FormalParameter>
			</FormalParameters>
			<ExtendedAttributes>
				<ExtendedAttribute Name="DataTableName" Value="" Description="Table name when the data being operated on is a Map"/>
			</ExtendedAttributes>
			<ExtendedAttributes>
				<ExtendedAttribute Name="DbActionType" Value="" Description="Database operation type; ignored if the same setting exists in the formal parameters"/>
			</ExtendedAttributes>                
		</Application>
		<Application Id="workflow_fetchDataAgent" Name="Fetch Data">
			<Description>Fetch database data</Description>
			<FormalParameters>
				<FormalParameter Id="Condition" Index="1" Mode="IN" Description="Data operation condition; can be a pojo or Map, used as the operation condition">
					<DataType>
						<ExternalReference location="java.lang.Object"/>
					</DataType>
				</FormalParameter>
			</FormalParameters>
			<ExtendedAttributes>
				<ExtendedAttribute Name="DataTableName" Value="" Description="Table name when the data being operated on is a Map"/>
			</ExtendedAttributes>
		</Application>            
	</Applications>
